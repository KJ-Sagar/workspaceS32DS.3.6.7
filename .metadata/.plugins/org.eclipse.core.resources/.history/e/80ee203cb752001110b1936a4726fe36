/* Including necessary configuration files. */
#include "Clock_Ip.h"
#include "FreeRTOS.h"
#include "task.h"
#include "semphr.h"
#include "CDD_Rm.h"

#define main_TASK_PRIORITY                ( tskIDLE_PRIORITY + 2 )

volatile uint32_t Task0_Core0 = 0;
volatile uint32_t Task1_Core0 = 0;
volatile uint32_t Task0_Core1 = 0;
volatile uint32_t Task1_Core1 = 0;
TaskHandle_t handle_Task0Core0;
TaskHandle_t handle_Task1Core0;
TaskHandle_t handle_Task0Core1;
TaskHandle_t handle_Task1Core1;

/* Master core signals system init done to rest of the cores */
__attribute__((section(".mcal_bss_no_cacheable"))) __attribute__((aligned(4))) 
volatile uint32_t ulSystemInitComplete = 0u;

/**
* @brief        Task0Core0
* @details      Task0Core0
*/
void Task0Core0( void *pvParameters )
{
	(void)pvParameters;
	TickType_t xLastWakeTime ;
	const TickType_t xFrequency = 200;

	xLastWakeTime = xTaskGetTickCount();
	for( ;; )
	{
		Task0_Core0++;
		vTaskDelayUntil(&xLastWakeTime, xFrequency);
	}
}

void Task0Core1( void *pvParameters )
{
	(void)pvParameters;
	TickType_t xLastWakeTime ;
	const TickType_t xFrequency = 200;

	xLastWakeTime = xTaskGetTickCount();
	for( ;; )
