/**
* @brief        Main function of the example
* @details      Initializes the used drivers and
*               4 tasks
*/

int main(void)
{
    if(vPortGET_CORE_ID() == configCORE_MASTER)
	{
	    /* Initialize Clock */
	    Clock_Ip_StatusType Status_Init_Clock = CLOCK_IP_ERROR;
	    Status_Init_Clock = Clock_Ip_Init(Clock_Ip_aClockConfig);

	    if (Status_Init_Clock != CLOCK_IP_SUCCESS)
	    {
	        while(1); /* Error during initialization. */
	    }

        /* Initialize RM CDD for XRDC config - needed for SEAM42 use in SMP demo */
        Rm_Init(NULL_PTR);

        /* Set flag and ensure visibility to rest of the cores */
        ulSystemInitComplete = 1u;
        __asm__ volatile("dsb" ::: "memory");


	    xTaskCreate( Task0Core0, ( const char * const ) "Task0Core0", configMINIMAL_STACK_SIZE, (void*)0, main_TASK_PRIORITY, &handle_Task0Core0 );
	    xTaskCreate( Task1Core0, ( const char * const ) "Task1Core0", configMINIMAL_STACK_SIZE, (void*)0, main_TASK_PRIORITY, &handle_Task1Core0 );
	    xTaskCreate( Task0Core1, ( const char * const ) "Task0Core1", configMINIMAL_STACK_SIZE, (void*)0, main_TASK_PRIORITY, &handle_Task0Core1 );
	    xTaskCreate( Task1Core1, ( const char * const ) "Task1Core1", configMINIMAL_STACK_SIZE, (void*)0, main_TASK_PRIORITY, &handle_Task1Core1 );
	    vTaskCoreAffinitySet(handle_Task0Core0, (1 << 0));
	    vTaskCoreAffinitySet(handle_Task1Core0, (1 << 0));
	    vTaskCoreAffinitySet(handle_Task0Core1, (1 << 3));
	    vTaskCoreAffinitySet(handle_Task1Core1, (1 << 3));
	    vTaskStartScheduler();
	}
    else
    {
        /* slave core(s) wait(s) for master core to complete system initialization */
        while( ulSystemInitComplete == 0u )
        {
            __asm__ volatile("nop");
        }
        __asm__ volatile("dmb" ::: "memory");

        xPortStartScheduler();
    }

    for( ;; );

    return 0;
}

